# Backup harian 03:00 WIB (20:00 UTC), diacak sampai 15 menit. Persistent: kalau server mati
# di jam itu, backup dijalankan begitu server menyala lagi.
[Unit]
Description=Jadwal backup off-site server-platform

[Timer]
OnCalendar=*-*-* 20:00:00 UTC
RandomizedDelaySec=15min
Persistent=true

[Install]
WantedBy=timers.target
